{
  "name": "odd-agy",
  "version": "0.1.3",
  "description": "Project-scoped ODD & RDD harness for Antigravity CLI/IDE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nathanael-Huaman/odd-agy.git"
  },
  "bin": {
    "odd-agy": "bin/odd-agy.mjs"
  },
  "files": [
    "bin/",
    "dist/bin/",
    "scripts/"
  ],
  "scripts": {
    "build": "node scripts/build-binaries.mjs",
    "test": "go test -count=1 ./... && node scripts/build-binaries.mjs && node bin/odd-agy.mjs --version",
    "test:go": "go test -count=1 ./...",
    "test:wrapper": "go test -v ./cmd/odd-agy -run TestWrapper",
    "test:e2e": "go test -v -count=1 ./tests/e2e/..."
  },
  "keywords": [
    "antigravity",
    "odd",
    "rdd",
    "agents",
    "mcp"
  ],
  "license": "MIT"
}
